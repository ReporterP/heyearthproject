[Unit]
Description=HeYearth Node Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/heyearth
ExecStart=/opt/heyearth/node-agent
Restart=always
RestartSec=5

Environment="PORT={{ node_agent_port | default('50052') }}"
Environment="TLS_CERT_FILE=/opt/heyearth/certs/server-cert.pem"
Environment="TLS_KEY_FILE=/opt/heyearth/certs/server-key.pem"
Environment="TLS_CA_FILE=/opt/heyearth/certs/ca-cert.pem"
Environment="SS_PUBLIC_HOST={{ ss_public_host | default(ansible_host | default(inventory_hostname)) }}"
Environment="SS_METHOD={{ ss_method | default('chacha20-ietf-poly1305') }}"
Environment="SS_BASE_PORT={{ ss_base_port | default('20000') }}"

[Install]
WantedBy=multi-user.target
