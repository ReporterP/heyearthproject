{
  "openapi": "3.0.3",
  "info": {
    "title": "HeYearth VPN API",
    "description": "REST API для получения персональной ссылки Shadowsocks по user_id. gRPC описан в proto/heyearth/v1/config.proto и доступен через reflection.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api/v1", "description": "API base" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/config": {
      "post": {
        "summary": "Получить или создать SS URI по user_id",
        "operationId": "getConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ConfigRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConfigResponse" }
              }
            }
          },
          "400": { "description": "Неверный user_id" },
          "503": { "description": "SS скрипт не настроен" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "example": "ok" } }
      },
      "ConfigRequest": {
        "type": "object",
        "required": ["user_id"],
        "properties": { "user_id": { "type": "string", "description": "UUID или идентификатор пользователя (макс 256 символов)" } }
      },
      "ConfigResponse": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "ss_uri": { "type": "string", "description": "Ссылка ss:// для клиента Shadowsocks/Outline" }
        }
      }
    }
  }
}
