{
  "api": {
    "services": [
      "HandlerService",
      "RoutingService",
      "StatsService"
    ],
    "tag": "api"
  },
  "dns": {
    "disableCache": false,
    "queryStrategy": "UseIPv4",
    "servers": [
      "8.8.8.8",
      "1.1.1.1"
    ],
    "tag": "dns-out"
  },
  "inbounds": [
