  "policy": {
    "levels": {
      "0": {
        "bufferSize": 256,
        "connIdle": 3600,
        "downlinkOnly": 5,
        "handshake": 4,
        "statsUserDownlink": true,
        "statsUserUplink": true,
        "uplinkOnly": 2
      },
      "1": {
        "bufferSize": 512,
        "connIdle": 3600,
        "downlinkOnly": 5,
        "handshake": 4,
        "statsUserDownlink": true,
        "statsUserUplink": true,
        "uplinkOnly": 2
      }
    },
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true,
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "routing": {
    "balancers": [
      {
        "fallbackTag": "exit-20.hy",
        "selector": [
          "exit-"
        ],
        "strategy": {
          "settings": {
            "baselines": [
              "50ms",
              "100ms",
              "200ms",
              "400ms",
              "800ms",
              "1600ms"
            ],
            "costs": [
              {
                "match": "^exit-2\\.hy$",
                "regexp": true,
                "value": 1296
              },
              {
                "match": "^exit-2\\.vr$",
                "regexp": true,
                "value": 518400
              },
              {
                "match": "^exit-3\\.hy$",
                "regexp": true,
                "value": 400
              },
              {
