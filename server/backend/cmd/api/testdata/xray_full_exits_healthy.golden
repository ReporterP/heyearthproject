                "regexp": true,
                "value": 1
              },
              {
                "match": "^exit-20\\.vr$",
                "regexp": true,
                "value": 400
              }
            ],
            "expected": 1
          },
          "type": "leastLoad"
        },
        "tag": "exit-balancer"
      },
