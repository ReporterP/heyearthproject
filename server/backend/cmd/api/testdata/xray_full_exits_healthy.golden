      "tag": "api-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "ip": "127.0.0.1",
        "udp": true
      },
      "sniffing": {
