        "security": "reality",
        "sockopt": {
          "tcpFastOpen": true,
          "tcpKeepAliveIdle": 120,
          "tcpKeepAliveInterval": 30,
          "tcpNoDelay": true
        },
        "xhttpSettings": {
          "host": "hiearth.ru",
          "mode": "auto",
          "path": "/",
          "scMaxBufferedPosts": 40,
          "scMaxEachPostBytes": "10000-15000",
          "xPaddingBytes": "100-1000"
        }
      },
      "tag": "vless-xhttp"
    },
    {
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
