      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "streamSettings": {
        "network": "xhttp",
        "realitySettings": {
          "dest": "yandex.ru:443",
          "privateKey": "priv",
          "serverNames": [
            "yandex.ru",
            "www.yandex.ru"
          ],
          "shortIds": [
            "sid",
            ""
