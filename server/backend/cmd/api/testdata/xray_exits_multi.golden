{
  "balancers": [
    {
      "fallbackTag": "exit-2.hy",
      "selector": [
        "exit-"
      ],
      "strategy": {
        "settings": {
          "costs": [
            {
              "match": "^exit-2\\.hy$",
              "regexp": true,
              "value": 10
            },
            {
              "match": "^exit-2\\.vr$",
              "regexp": true,
              "value": 1000
            },
            {
              "match": "^exit-3\\.hy$",
              "regexp": true,
              "value": 6
            },
            {
              "match": "^exit-3\\.vr$",
              "regexp": true,
              "value": 600
            },
            {
              "match": "^exit-20\\.hy$",
              "regexp": true,
              "value": 1
            },
            {
              "match": "^exit-20\\.vr$",
              "regexp": true,
              "value": 100
            }
          ]
        },
        "type": "leastLoad"
      },
      "tag": "exit-balancer"
    },
    {
      "fallbackTag": "exit-2.hy",
      "selector": [
        "exit-2."
      ],
      "strategy": {
        "settings": {
          "costs": [
            {
              "match": "^exit-2\\.hy$",
              "regexp": true,
              "value": 10
            },
            {
              "match": "^exit-2\\.vr$",
