# HiEarth — Clash/ClashMeta Config
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info

proxies:
  - name: "HiEarth-Home"
    type: vless
    server: 203.0.113.50
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: chrome
    servername: storage.yandexcloud.net
  - name: "HiEarth-Mobile"
    type: vless
    server: 203.0.113.50
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: firefox
    servername: storage.yandexcloud.net
  - name: "HiEarth-Strict"
    type: vless
    server: 203.0.113.50
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: edge
    servername: storage.yandexcloud.net
  - name: "HiEarth-XHTTP"
    type: vless
    server: 203.0.113.50
    port: 2443
    uuid: "11111111-2222-4333-8444-555555555555"
    network: xhttp
    xhttp-opts:
      path: "/"
      host: hub.example.test
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: chrome
    servername: storage.yandexcloud.net
  - name: "HiEarth-Express"
    type: hysteria2
    server: 203.0.113.50
    ports: 30000-65000
    password: "hy2-password-test"
    obfs: salamander
    obfs-password: "obfs-test"
    sni: tls.example.test
    skip-cert-verify: false
    up: "30 Mbps"
    down: "120 Mbps"

proxy-groups:
  - name: "HiEarth"
    type: select
    proxies:
      - "HiEarth-Home"
      - "HiEarth-Mobile"
      - "HiEarth-Strict"
      - "HiEarth-XHTTP"
      - "HiEarth-Express"
      - DIRECT

rules:
  - MATCH,HiEarth
