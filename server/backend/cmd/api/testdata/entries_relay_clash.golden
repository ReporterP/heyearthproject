# HeYearth — Clash/ClashMeta Config
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info

proxies:
  - name: "HeYearth-Home"
    type: vless
    server: hub.example.test
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: chrome
    servername: storage.yandexcloud.net
  - name: "HeYearth-Mobile"
    type: vless
    server: hub.example.test
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
      public-key: "PBK-test"
      short-id: "ab12"
    client-fingerprint: firefox
    servername: storage.yandexcloud.net
  - name: "HeYearth-Strict"
