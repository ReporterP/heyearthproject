    type: select
    proxies:
      - "HeYearth-Home"
      - "HeYearth-Mobile"
      - "HeYearth-Strict"
      - "HeYearth-XHTTP"
      - "HiEarth-Express"
      - "HeYearth-Home · резерв"
      - "HeYearth-XHTTP · резерв"
      - "HiEarth-Express · резерв"
      - "HeYearth-Home · резерв 2"
      - "HeYearth-XHTTP · резерв 2"
