    ports: 30000-65000
    password: "hy2-password-test"
    obfs: salamander
    obfs-password: "obfs-test"
    sni: hub.example.test
    skip-cert-verify: false
    up: "30 Mbps"
    down: "120 Mbps"
  - name: "HeYearth-Home · резерв"
    type: vless
    server: 203.0.113.50
    port: 443
    uuid: "11111111-2222-4333-8444-555555555555"
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    reality-opts:
