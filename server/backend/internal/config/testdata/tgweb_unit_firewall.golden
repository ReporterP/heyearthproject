[Unit]
Description=Drop the WEB proxy MTProxy's ports off loopback (heyearth phase T)
After=nftables.service
PartOf=nftables.service
Before=heyearth-tg-mtproxy.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/sbin/nft -f /etc/heyearth/tg-mtproxy/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/heyearth/tg-mtproxy/firewall.nft
ExecStop=-/usr/sbin/nft delete table inet heyearth_tg_mtproxy

[Install]
WantedBy=multi-user.target
