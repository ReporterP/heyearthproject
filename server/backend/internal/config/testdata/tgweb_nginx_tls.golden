# Generated by heyearth-api (config.TGWebNginxConf): Telegram WEB proxy tg.example.ru. Do not edit.
server {
    listen 80;
    listen [::]:80;
    server_name tg.example.ru;
    access_log off;
    return 301 https://$host$request_uri;
}

map $http_upgrade $heyearth_tg_connection {
    default upgrade;
    ''      "";
}

upstream heyearth_tg_relay {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 8443 ssl http2;
    listen [::]:8443 ssl http2;
    # PROXY-protocol listener (127.0.0.1 only): the 443 router in PROXY mode and the RU entries
    listen 127.0.0.1:8446 ssl http2 proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    server_name tg.example.ru;

    ssl_certificate /etc/letsencrypt/live/tg.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tg.example.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    ssl_ecdh_curve X25519:prime256v1;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # The bridge URI (/?bridge=...) and the carrier's bearer are credentials.
    access_log off;
    client_max_body_size 0;

    location / {
        proxy_pass http://heyearth_tg_relay;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Exactly one address: the relay refuses a list of them.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $heyearth_tg_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
