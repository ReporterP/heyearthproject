# Generated by heyearth (config.TunnelUnit): GRE 198.51.100.42 <-> 198.51.100.2, 10.77.0.26 -> 10.77.0.25. Do not edit.
[Unit]
Description=HiEarth GRE tunnel he-hub to 198.51.100.2
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-ip link del he-hub
ExecStart=ip tunnel add he-hub mode gre local 198.51.100.42 remote 198.51.100.2 ttl 64
ExecStart=ip addr add 10.77.0.26 peer 10.77.0.25 dev he-hub
ExecStart=ip link set he-hub mtu 1476 up
ExecStop=-ip link del he-hub
[Install]
WantedBy=multi-user.target
