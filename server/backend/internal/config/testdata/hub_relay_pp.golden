# Generated by heyearth (config.HubRelayPPConf): TCP 443 of the reserve entries arrives here. Do not edit.
map $ssl_preread_server_name $relay_backend {
    admin.hiearth.ru             relay_nginx_pp;
    hiearth.ru                   relay_nginx_pp;
    default                      relay_xray_pp;
}

upstream relay_nginx_pp {
    server 127.0.0.1:8446;
}

upstream relay_xray_pp {
    server 127.0.0.1:10444;
}

server {
    listen 8447 proxy_protocol so_keepalive=60s:10s:3;
    # Only a reserve entry may set the client's address (one file per entry).
    include /etc/nginx/heyearth-relays/*.conf;
    ssl_preread on;
    proxy_protocol on;
    proxy_timeout 3600s;
    proxy_pass $relay_backend;
}
