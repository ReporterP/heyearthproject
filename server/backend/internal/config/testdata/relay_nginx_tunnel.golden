# Generated by heyearth (config.RelayNginxConf): reserve entry, TCP 443/80 to the Hub 198.51.100.2 through the tunnel 10.77.0.25. Do not edit.
user www-data;
worker_processes auto;
worker_rlimit_nofile 65535;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 16384;
}

stream {
    # The Hub's tunnel address first (2 tries: one pair of outer addresses, never lost by the
    # tuple), then its public address as backup (6 tries, each a new connection on a new source port).
    upstream heyearth_hub_pp {
        server 10.77.0.25:8447 max_fails=0;
        server 10.77.0.25:8447 max_fails=0;
        server 198.51.100.2:8447 max_fails=0 backup;
        server 198.51.100.2:8447 max_fails=0 backup;
        server 198.51.100.2:8447 max_fails=0 backup;
        server 198.51.100.2:8447 max_fails=0 backup;
        server 198.51.100.2:8447 max_fails=0 backup;
        server 198.51.100.2:8447 max_fails=0 backup;
    }
    upstream heyearth_hub_80 {
        server 10.77.0.25:80 max_fails=0;
        server 10.77.0.25:80 max_fails=0;
        server 198.51.100.2:80 max_fails=0 backup;
        server 198.51.100.2:80 max_fails=0 backup;
        server 198.51.100.2:80 max_fails=0 backup;
        server 198.51.100.2:80 max_fails=0 backup;
        server 198.51.100.2:80 max_fails=0 backup;
        server 198.51.100.2:80 max_fails=0 backup;
    }

    # Users: Reality «Берёза», the site and the subscription. The PROXY header tells the Hub the
    # client's real address.
    server {
        listen 443 so_keepalive=60s:10s:3;
        proxy_pass heyearth_hub_pp;
        proxy_protocol on;
        proxy_connect_timeout 1s;
        proxy_next_upstream on;
        proxy_next_upstream_tries 8;
        proxy_next_upstream_timeout 10s;
        proxy_timeout 3600s;
    }
    # The site's certificate renewal (ACME http-01) when its domain points at this entry.
    server {
        listen 80;
        proxy_pass heyearth_hub_80;
        proxy_connect_timeout 1s;
        proxy_next_upstream on;
        proxy_next_upstream_tries 8;
        proxy_next_upstream_timeout 10s;
        proxy_timeout 60s;
    }
}
