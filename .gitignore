# ── Secrets & env ──────────────────────────────────────
.env
.env.local
.env.*.local
.release-app-update.env

# ── OS / IDE ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# ── Python (legacy) ───────────────────────────────────
__pycache__/
*.pyc

# ── Backups ────────────────────────────────────────────
backups/

# FVM Version Cache
.fvm/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
# Build artifacts (generated by vite build)
site/dist/
admin_web/dist/
server/backend/heyearth-api
server/backend/heyearth-api.bin
.superpowers/
.plan-tmp/

# Local secrets — never commit (CA/leaf private keys, per-user Claude settings with credentials)
.claude/settings.local.json
server/backend/certs/*-key.pem

# Architecture pages carry the Hub/exit addresses: never in the public repo
docs/architecture/*.html

# Cleanup plan D4: binaries, downloaded tools and certificates never go to git
server/backend/.build/
.tools/
server/backend/certs/
*.exe
.tmp_*
