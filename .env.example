# Копируй в .env и заполни значения.
# Для деплоя (нужен Go): go run ./backend/cmd/deploy --fresh | --update | --restart | --site
# или: python scripts/deploy.py --fresh (запускает тот же Go-деплой)

# SSH
# Beget: 1) Включи SSH на главной странице панели (cp.beget.com), в меню слева.
#        2) Виртуальный хостинг — в DEPLOY_HOST укажи ИМЯ СЕРВЕРА из панели (таблица «Общая информация»), не IP сайта. Логин/пароль = от панели.
#        3) VPS — в панели раздел «Облако», реквизиты root@IP. Порт у Beget обычно 22.
DEPLOY_HOST=155.212.225.172
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_SSH_PASSWORD=твой_пароль

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Домен сайта и HTTPS
# Без LETSENCRYPT_EMAIL сайт будет только по http://. Для https:// задай email и выполни: python scripts/deploy.py --site
SITE_DOMAIN=heyearth.ru
LETSENCRYPT_EMAIL=

# Shadowsocks (опционально; по умолчанию порт 8388, хост = SITE_DOMAIN)
# SS_PORT=8388
# SS_HOST=heyearth.ru

# Обновления приложения без Google Play (опционально; API: GET /api/v1/app/update)
# APP_UPDATE_VERSION=1.0.1
# APP_UPDATE_URL_ANDROID=https://heyearth.ru/releases/heyearth-1.0.1.apk
# APP_UPDATE_URL_WINDOWS=https://heyearth.ru/releases/heyearth-1.0.1-windows.exe
# APP_UPDATE_RELEASE_NOTES=Исправления и улучшения.
