{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Go Backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "./cmd/api"],
      "port": 8000
    },
    {
      "name": "Admin Web (React + Vite)",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd admin_web && npx vite --port 5173"],
      "port": 5173
    },
    {
      "name": "Site (React + Vite)",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd site && npx vite --port 5174"],
      "port": 5174
    },
    {
      "name": "Site Vue (Vue 3 + Vite)",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd site_vue && npx vite --port 5175"],
      "port": 5175
    }
  ]
}
