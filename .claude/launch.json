{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Go Backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "./cmd/api"],
      "port": 8000
    },
    {
      "name": "Admin Web (React + Vite)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "admin_web", "vite", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "Site (React + Vite)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "dev", "--port", "5174"],
      "port": 5174,
      "cwd": "site"
    }
  ]
}
