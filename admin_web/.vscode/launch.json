{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "admin_web (production API)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=HEYEARTH_ADMIN_API_BASE=https://quizgame.pro/api/admin"
      ]
    },
    {
      "name": "admin_web (local API :8000)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=HEYEARTH_ADMIN_API_BASE=http://127.0.0.1:8000/api/admin"
      ]
    }
  ]
}
